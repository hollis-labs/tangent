{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Whiteboard envelope data",
  "description": "Render a tldraw-backed whiteboard with optional seeded scene state and reference-only assets.",
  "properties": {
    "board_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "intent": {
      "type": "string"
    },
    "scene": {
      "type": "object"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "asset_id": { "type": "string" },
          "artifact_id": { "type": "string" },
          "name": { "type": "string" },
          "mime_type": { "type": "string" },
          "source": { "type": "string" },
          "width": { "type": "integer", "minimum": 0 },
          "height": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "string"
    },
    "tool_mode": {
      "type": "string",
      "enum": ["select", "draw", "text", "shape", "arrow", "note"]
    },
    "reference_images": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": ["board_id"],
  "additionalProperties": false
}
