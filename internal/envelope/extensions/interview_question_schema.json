{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Interview question envelope data",
  "description": "Prompt one interview question with optional quick-pick choices and explicit output-shape capture.",
  "properties": {
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "prompt_markdown": {
      "type": "string",
      "minLength": 1
    },
    "helper_text": {
      "type": "string"
    },
    "choices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "thread_id": {
      "type": "string",
      "minLength": 1
    },
    "topic_label": {
      "type": "string",
      "minLength": 1
    },
    "output_shape": {
      "type": "object",
      "required": [
        "label"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "help": {
          "type": "string"
        },
        "placeholder": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "anyOf": [
    {
      "required": [
        "prompt"
      ]
    },
    {
      "required": [
        "prompt_markdown"
      ]
    }
  ],
  "allOf": [
    {
      "anyOf": [
        {
          "required": [
            "thread_id"
          ]
        },
        {
          "required": [
            "topic_label"
          ]
        }
      ]
    }
  ],
  "additionalProperties": false
}
