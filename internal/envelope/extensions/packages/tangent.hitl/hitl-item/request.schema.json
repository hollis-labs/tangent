        "updated_at": { "type": "string", "format": "date-time" },
        "terminal_outcome": { "$ref": "#/$defs/HITLTerminalOutcomeV1" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": { "enum": ["resolved", "canceled", "expired", "failed", "superseded"] }
            },
            "required": ["state"]
          },
          "then": {
            "required": ["terminal_outcome"],
            "properties": { "queue_position": { "type": "null" } }
          },
          "else": {
            "properties": {
              "queue_position": { "type": "integer", "minimum": 1 },
              "terminal_outcome": false
            }
          }
        },
        {
          "if": { "properties": { "state": { "enum": ["resolved"] } }, "required": ["state"] },
          "then": { "properties": { "terminal_outcome": { "$ref": "#/$defs/ResolvedTerminalOutcomeV1" } } }
        },
        {
          "if": { "properties": { "state": { "enum": ["canceled"] } }, "required": ["state"] },
          "then": { "properties": { "terminal_outcome": { "$ref": "#/$defs/CanceledTerminalOutcomeV1" } } }
        },
        {
          "if": { "properties": { "state": { "enum": ["expired"] } }, "required": ["state"] },
          "then": { "properties": { "terminal_outcome": { "$ref": "#/$defs/ExpiredTerminalOutcomeV1" } } }
        },
        {
          "if": { "properties": { "state": { "enum": ["failed"] } }, "required": ["state"] },
          "then": { "properties": { "terminal_outcome": { "$ref": "#/$defs/FailedTerminalOutcomeV1" } } }
        },
        {
          "if": { "properties": { "state": { "enum": ["superseded"] } }, "required": ["state"] },
          "then": { "properties": { "terminal_outcome": { "$ref": "#/$defs/SupersededTerminalOutcomeV1" } } }
        }
      ],
      "additionalProperties": false
    },
