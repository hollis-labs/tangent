        "item_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "state": {
          "type": "string",
          "enum": ["submitted", "validated", "staged", "presented", "in_progress", "resolved", "canceled", "expired", "failed", "superseded"]
        },
        "revision": { "type": "integer", "minimum": 1 },
        "queue_sequence": { "type": "integer", "minimum": 1 },
