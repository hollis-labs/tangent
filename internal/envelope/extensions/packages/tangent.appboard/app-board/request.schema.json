{
  "type": "object",
  "properties": {
    "board_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "source": {
      "type": "object",
      "properties": {
        "app": { "type": "string" },
        "label": { "type": "string" }
      }
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "card_ids": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["id", "label"]
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "subtitle": { "type": "string" },
          "badges": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "label": { "type": "string", "minLength": 1 },
                "tone": { "type": "string", "enum": ["neutral", "info", "success", "warning", "danger"] }
              },
              "required": ["label"]
            }
          },
          "body": { "type": "string" },
          "note": {
            "type": "string",
            "description": "A note already recorded against this card. The note control seeds from it, so a participant sees what was recorded rather than an empty box, and editing it replaces it. Absent means no note is on record. The board does not interpret a note or act on one; what a recorded note means is the caller's business."
          },
          "fields": { "type": "object" }
        },
        "required": ["id", "title"]
      }
    },
    "filters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["single", "multi", "text"] },
          "field": { "type": "string" },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": { "type": "string", "minLength": 1 },
                "label": { "type": "string" },
                "count": { "type": "integer", "minimum": 0 }
              },
              "required": ["value"]
            }
          },
          "selected": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["id", "label", "kind"]
      }
    },
    "detail": {
      "type": "object",
      "properties": {
        "card_id": { "type": "string" },
        "open": { "type": "boolean" },
        "raised_by": { "type": "string", "enum": ["agent", "user"] },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "markdown": { "type": "string" }
            },
            "required": ["label"]
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "tone": { "type": "string", "enum": ["neutral", "primary", "danger"] }
            },
            "required": ["id", "label"]
          }
        }
      }
    },
    "sync": {
      "type": "object",
      "description": "What the board may use to talk back to the caller without an agent turn. Absent means the board is a read-only view.",
      "properties": {
        "enabled": { "type": "boolean" },
        "endpoint": {
          "type": "string",
          "pattern": "^/api/plugins/[^/]+/",
          "description": "Same-origin path under the host's reserved plugin route prefix. The renderer refuses anything else: a board is not a general fetch surface."
        },
        "label": { "type": "string" },
        "stage_label": {
          "type": "string",
          "description": "Names the control that stages a card into another column. Empty means staging is not offered even when enabled is true."
        },
        "note_label": {
          "type": "string",
          "description": "Names the per-card free-text control. Empty means no note is offered even when enabled is true. A note is view state like a staged column move — it is recorded in the draft and means nothing to the owning application until the participant presses sync, and the caller decides what to do with it. The board neither interprets it nor sends it anywhere itself."
        },
        "scope": {
          "type": "string",
          "description": "What the caller sent, in its own words, so a filter that finds nothing reads as a scope rather than a defect."
        }
      }
    },
    "updated_at": { "type": "string" }
  },
  "required": ["board_id", "cards"]
}
