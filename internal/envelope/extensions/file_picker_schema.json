        "properties": {
          "artifact_id": { "type": "string" },
          "name": { "type": "string" },
          "uri": { "type": "string" },
          "mime_type": { "type": "string" },
          "kind": { "type": "string" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "root_id": { "type": "string", "minLength": 1 },
