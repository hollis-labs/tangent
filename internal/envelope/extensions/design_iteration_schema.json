{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Tangent design-iteration envelope data",
  "required": ["html", "variant_id", "prompts"],
  "properties": {
    "caption": {
      "type": "string",
      "description": "Optional human-facing instruction shown above the preview."
    },
    "variant_id": {
      "type": "string",
      "minLength": 1,
      "description": "Agent-assigned identifier for this iteration variant."
    },
    "html": {
      "type": "string",
      "minLength": 1,
      "description": "Sandboxed HTML rendered into an iframe srcdoc."
    },
    "prompts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "enum": ["click-region", "button", "text-input"]
          },
          "label": { "type": "string" },
          "selector": {
            "type": "string",
            "description": "CSS selector for click-region prompts inside the iframe."
          },
          "placeholder": { "type": "string" }
        },
        "allOf": [
          {
            "if": {
              "properties": { "kind": { "const": "click-region" } },
              "required": ["kind"]
            },
            "then": {
              "required": ["selector", "label"]
            }
          },
          {
            "if": {
              "properties": { "kind": { "const": "button" } },
              "required": ["kind"]
            },
            "then": {
              "required": ["label"]
            }
          },
          {
            "if": {
              "properties": { "kind": { "const": "text-input" } },
              "required": ["kind"]
            },
            "then": {
              "required": ["label"]
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
