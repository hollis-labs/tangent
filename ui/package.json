{
  "name": "tangent-ui",
  "private": true,
  "version": "0.16.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "preview": "vite preview",
    "test": "vitest --passWithNoTests",
    "theme:gen": "node scripts/gen-tangent-theme.mjs > src/styles/tangent-theme.css && biome format --write src/styles/tangent-theme.css",
    "theme:verify": "node scripts/verify-derivation.mjs",
    "check:design": "node tools/design-lint/node_modules/@hollis-labs/eslint-config-design/scripts/biome-check.mjs src",
    "check:design:update": "node tools/design-lint/node_modules/@hollis-labs/eslint-config-design/scripts/biome-check.mjs --update src"
  },
  "dependencies": {
    "@hollis-labs/design-app-runtime": "^0.1.0",
    "@hollis-labs/design-bindings": "^0.1.0",
    "@hollis-labs/design-components": "^0.1.0",
    "@hollis-labs/design-tokens": "^0.1.0",
    "@hollis-labs/kit-dashboard": "^0.1.0",
    "@hollis-labs/plugin-registry": "^0.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.44.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tldraw": "^5.4.1",
    "zod": "^4.6.1",
    "zustand": "^5.0.15",
    "@base-ui/react": "^1.8.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.14.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.0"
  }
}
