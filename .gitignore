# Go binary (top-level build output)
/tangent
/tangent-new-plugin

# Go build / test artifacts
*.test
*.out
coverage.out
coverage.html

# Frontend
/ui/dist/
/ui/node_modules
/ui/node_modules/
/ui/.vite/
/ui/*.tsbuildinfo

# Vite build output is written here for go:embed; ignore everything
# except the .gitkeep placeholder so the embed directive resolves on a
# clean checkout.
/internal/server/ui_dist/*
!/internal/server/ui_dist/.gitkeep

# Logs
*.log

# macOS
.DS_Store

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo

# Local scratch
/tmp/
/.tangent/

# Claude client runtime state (worktrees, local settings, locks)
/.claude/

# Cerberus source-tree build lock
.cerberus-build.lock

# Built plugin directories; also the shared app-build workflow writes dist/build-info.json into the
# checkout, and an untracked file there makes Go stamp the build as modified (+dirty)
/dist/
/internal/webui/dist/*
!/internal/webui/dist/.gitkeep
